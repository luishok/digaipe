# Copie este archivo a deploy/.env y complete los valores.
# Use solo letras y números en las contraseñas: van dentro de una URL de conexión.

# Contraseña del usuario root de MySQL (solo la usa el contenedor de instalación).
MYSQL_ROOT_PASSWORD=

# Usuario de MySQL con permisos mínimos que usa la aplicación.
APP_DB_USER=digaipe_app
APP_DB_PASSWORD=

# Cuenta de MySQL que usan los respaldos automáticos: solo puede leer la base para respaldarla
# y anotar el resultado en la auditoría. La restauración usa root.
BACKUP_DB_USER=digaipe_respaldo
BACKUP_DB_PASSWORD=

# Cuenta de MySQL de solo lectura para auditoría (opcional: se crea solo si hay contraseña).
# No ve contraseñas, tokens de sesión ni códigos de verificación. Exige conexión cifrada.
READONLY_DB_USER=digaipe_lectura
READONLY_DB_PASSWORD=

# Nombre o IP con el que las PCs de la red abren el sistema (sin https:// ni puerto),
# por ejemplo digaipe.ula.local o 192.168.1.50. El certificado HTTPS se emite para este valor.
DIGAIPE_HOST=
# Debe ser https:// seguido exactamente de DIGAIPE_HOST.
ORIGIN=https://

# Etiqueta de las imágenes Docker (útil al moverlas a una red sin internet).
DIGAIPE_VERSION=local

# 32 caracteres o más, aleatorios. Por ejemplo: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Primer administrador. Se crea solo si no existe.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador

# Respaldos automáticos (servicio backup-worker). Ver docs/respaldos.md.
# Carpeta en el equipo, idealmente un disco aparte del de la base de datos.
BACKUP_DIR=./backups
# Cada cuántos días y a qué hora UTC (6 = 02:00 en Caracas).
BACKUP_INTERVAL_DAYS=7
BACKUP_HOUR_UTC=6
# Se borran los respaldos de más de BACKUP_KEEP_DAYS días, pero siempre se conservan los
# BACKUP_KEEP_MIN más recientes. 70 días / 10 = unos 2 meses y medio de respaldos semanales.
BACKUP_KEEP_DAYS=70
BACKUP_KEEP_MIN=10
# No se inicia un respaldo con menos espacio libre (MB) que esto o el doble del último.
BACKUP_MIN_FREE_MB=512

# Carpeta del archivo de anclas de auditoría. Debe estar en un medio que el administrador
# de la base de datos NO pueda modificar (USB del auditor, carpeta compartida de otra PC).
ANCHOR_DIR=./anchors
