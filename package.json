{
	"name": "digaipe",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:statistics": "tsx --test src/lib/server/admisiones/report-mode.spec.ts",
		"test:login-throttle": "tsx --test src/lib/server/login-throttle.spec.ts",
		"test:csv": "tsx --test src/lib/server/admisiones/csv.spec.ts",
		"test:permissions": "tsx --test src/lib/permissions.spec.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:rebuild:dev": "tsx scripts/rebuild-dev-db.ts",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"digaipe:updateall": "npm run auth:schema && npm run db:generate && npm run db:migrate && npm run digaipe:bootstrap-admin && npm run digaipe:seed-addmision-mod && npm run digaipe:ocre-types",
		"digaipe:bootstrap-admin": "npx tsx scripts/bootstrap-admin.ts",
		"digaipe:seed-addmision-mod": "tsx scripts/load_admission_mod.ts",
		"digaipe:ocre-types": "tsx scripts/load_ocre_types.ts",
		"audit:verify": "tsx scripts/audit-ledger.ts verify",
		"audit:anchor": "tsx scripts/audit-ledger.ts anchor"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24.13.3",
		"auth": "^1.7.14",
		"better-auth": "^1.7.14",
		"dotenv": "^17.4.2",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"mysql2": "^3.24.6",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vite": "^7.3.7"
	},
	"dependencies": {
		"csv-parse": "^7.0.3",
		"pdf-lib": "^1.17.1",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	}
}
