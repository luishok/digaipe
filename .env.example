# Local development environment. Copy to .env and fill in the blanks.
# This file is read by `npm run dev`, drizzle-kit and the scripts/ helpers (via dotenv).
# For the Docker deployment (app + MySQL + Caddy + backups) use deploy/.env.example instead.

# --- Database (MySQL) ---------------------------------------------------------------------
# Matches the dev container in compose.yaml (`npm run db:start`).
# Keep host=localhost and database=local: `npm run db:rebuild:dev` refuses any other target.
# Passwords go inside a URL: use letters and digits only, or percent-encode special characters.
DATABASE_URL="mysql://root:mysecretpassword@localhost:3306/local"

# --- App / Better Auth --------------------------------------------------------------------
# Public base URL the browser uses to open the app (scheme + host + port, no trailing slash).
# Dev server: http://localhost:5173. Built app (`node build`): http://localhost:3000.
# With https:// Better Auth marks session cookies Secure.
ORIGIN="http://localhost:5173"

# Signing secret for sessions. 32+ random characters, e.g. `openssl rand -hex 32`.
# Changing it logs everyone out.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# --- First administrator (`npm run digaipe:bootstrap-admin`, `npm run db:rebuild:dev`) -----
# Created only if the user does not exist yet. Required by both commands.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Administrador"

# --- Dev database reset (`npm run db:rebuild:dev`) ----------------------------------------
# Destroys the local Docker volume and rebuilds the database. Set to YES only for that run;
# it also refuses to run when NODE_ENV=production.
DIGAIPE_CONFIRM_DEV_DB_RESET=""

# --- Least-privilege MySQL accounts (scripts/grant-db-users.ts) -----------------------------
# Optional in dev: only needed if you run the grant script locally to mirror production.
# It must run with DATABASE_URL pointing at root. Usernames: 1-32 letters, digits or underscores.
# APP_DB_PASSWORD is required by the script; the other two accounts are created only when
# their password is set.
APP_DB_USER="digaipe_app"
APP_DB_PASSWORD=""
BACKUP_DB_USER="digaipe_respaldo"
BACKUP_DB_PASSWORD=""
READONLY_DB_USER="digaipe_lectura"
READONLY_DB_PASSWORD=""

# --- Built app only (`npm run build && node build`, adapter-node) ---------------------------
# Not used by `vite dev`. Admission uploads (spreadsheet + manifest PDF) exceed the 512K default.
BODY_SIZE_LIMIT="50M"
# Port the built server listens on (adapter-node default 3000).
# PORT=3000
# Only set these behind a reverse proxy; they make the audit log and login throttle trust
# the proxy's X-Forwarded-For entry as the client address.
# ADDRESS_HEADER="X-Forwarded-For"
# XFF_DEPTH="1"
